APP_NAME=shelfcash-backend
ENVIRONMENT=development
POSTGRES_DB=shelfcash
POSTGRES_USER=shelfcash
POSTGRES_PASSWORD=shelfcash
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://shelfcash:shelfcash@127.0.0.1:5432/shelfcash
TEST_DATABASE_URL=postgresql+psycopg://shelfcash:shelfcash@127.0.0.1:5432/shelfcash_test
RUNTIME_DIRECTORY=runtime
UPLOAD_DIRECTORY=runtime/uploads
MODEL_ARTIFACT_DIRECTORY=runtime/model_artifacts
# OpenRouter / Qwen: chỉ đề xuất mapping import, không quyết định dữ liệu nghiệp vụ.
# Điền key thật vào .env riêng; không đưa key vào file mẫu hoặc FE.
OPENROUTER_API_KEY=
# Có key không tự bật AI. Chỉ đổi true khi sẵn sàng gọi provider thật.
IMPORT_LLM_SUGGESTIONS_ENABLED=false
# Model ID theo adapter OpenRouter; không dùng cú pháp qwen3.5:9B của Ollama.
OPENROUTER_MAPPING_MODEL=qwen/qwen3.5-9b
# Timeout mỗi transport attempt; tổng deadline cho một sheet (tối đa 2 attempts).
OPENROUTER_MAPPING_TIMEOUT_SECONDS=30
OPENROUTER_MAPPING_DEADLINE_SECONDS=60
# Giới hạn dòng mẫu 1..8 và output tokens 128..1800.
OPENROUTER_MAPPING_SAMPLE_LIMIT=8
OPENROUTER_MAPPING_MAX_TOKENS=1800
# JSON provider allowlist. [] dùng routing OpenRouter; không hardcode SiliconFlow.
# Khi có allowlist, adapter tắt fallback ra ngoài danh sách.
OPENROUTER_MAPPING_PROVIDERS=[]
# Biến tổng quát hiện không chọn model cho import; giữ trống.
OPENROUTER_MODEL=

# S4.1 browser origins: exact JSON list. Empty denies browser mutations.
AUTH_ALLOWED_ORIGINS=[]
AUTH_DEV_COOKIE=false
# Configure operator/delivery secrets privately, never commit real values.
AUTH_OPERATOR_ID=
AUTH_OPERATOR_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_DELIVERY_SENDER=
AUTH_FRONTEND_URL=
# S4.2: separate HTTPS invitation page; a private base64-encoded random32-byte key.
# Keep this key available while queued intents exist; never commit a real value.
AUTH_INVITATION_FRONTEND_URL=
AUTH_DELIVERY_ENCRYPTION_KEY=
# Import analyze/preview cần worker: đổi true nếu chạy worker trong process BE.
# Giữ false nếu đã chạy worker bằng cơ chế riêng; không chạy trùng worker.
IMPORT_WORKER_ENABLED=false
# S4.9 independent planning execution opt-in; keep false until operator enables.
PLANNING_WORKER_ENABLED=false
# S4.10 independent private retained-PDF worker, explicitly enabled by operator.
PDF_EXPORT_WORKER_ENABLED=false
