# Customer local profile. Copy to ignored .env; then run: python -m scripts.local_runtime secrets
APP_NAME=shelfcash-backend
ENVIRONMENT=development
# Used ONLY to initialize a new compose.local.yaml volume. Existing DB passwords do not change.
POSTGRES_USER=shelfcash_local_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
LOCAL_POSTGRES_CONTAINER=shelfcash-local-postgres-1
LOCAL_PORT=8103
# Distinct limited runtime/migration/test identities. URL-encode manually supplied passwords.
DATABASE_URL=postgresql+psycopg://shelfcash_local_runtime:CHANGE_ME@127.0.0.1:5433/shelfcash_local
MIGRATION_DATABASE_URL=postgresql+psycopg://shelfcash_local_migrator:CHANGE_ME@127.0.0.1:5433/shelfcash_local
TEST_DATABASE_URL=postgresql+psycopg://shelfcash_local_tester:CHANGE_ME@127.0.0.1:5433/shelfcash_local_test
RUNTIME_DIRECTORY=runtime/local/app
UPLOAD_DIRECTORY=runtime/local/app/uploads
MODEL_ARTIFACT_DIRECTORY=runtime/local/app/models
AUTH_ALLOWED_ORIGINS=["https://localhost:5173"]
AUTH_DEV_COOKIE=false
# Operators only; customers use signup/verify/login and POST /api/v1/stores.
AUTH_OPERATOR_ID=
AUTH_OPERATOR_KEY=
# TLS SMTP adapter supports implicit SSL (465), not STARTTLS/587.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_DELIVERY_SENDER=
# Filled privately by local_runtime secrets: random 32 bytes, base64. Keep while intents exist.
AUTH_DELIVERY_ENCRYPTION_KEY=
# SETUP/RESET page confirmed in FE. EMAIL_VERIFY page is not yet confirmed: leave unset.
AUTH_FRONTEND_URL=https://localhost:5173/credentials/complete
AUTH_PASSWORD_RESET_FRONTEND_URL=https://localhost:5173/credentials/complete
AUTH_VERIFICATION_FRONTEND_URL=
# Confirmed parameterized FE route; formatter substitutes UUID, token stays in fragment.
AUTH_INVITATION_FRONTEND_URL=https://localhost:5173/invitations/{invitation_id}
# Enable only after SMTP/key/callbacks are configured. One owned thread handles all email queues.
AUTH_EMAIL_DELIVERY_ENABLED=false
IMPORT_WORKER_ENABLED=true
PLANNING_WORKER_ENABLED=true
PDF_EXPORT_WORKER_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
# Separate explicit provider opt-in; no live calls during setup/tests.
IMPORT_LLM_SUGGESTIONS_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MAPPING_MODEL=qwen/qwen3.5-9b
OPENROUTER_MAPPING_TIMEOUT_SECONDS=30
OPENROUTER_MAPPING_DEADLINE_SECONDS=60
OPENROUTER_MAPPING_SAMPLE_LIMIT=8
OPENROUTER_MAPPING_MAX_TOKENS=1800
OPENROUTER_MAPPING_PROVIDERS=[]
# Decision Assistant summary is a separate opt-in; key presence never enables it.
# Configure a model only after separate live-data/cost approval. Empty providers
# selects OpenRouter default routing, allow_fallbacks=false; no model substitution.
# AS03 uses the independent CHAT_* profile below with the shared transport key.
SUMMARY_LLM_ENABLED=false
SUMMARY_MODEL=
SUMMARY_PROVIDERS=[]
SUMMARY_MAX_TOKENS=256
SUMMARY_INPUT_BYTES=16000
SUMMARY_TIMEOUT_SECONDS=20
SUMMARY_DEADLINE_SECONDS=25
# Conversational AS03 is independently opt-in; summary/import flags never enable it.
# Empty providers explicitly uses OpenRouter default routing, no fallback.
CHAT_LLM_ENABLED=false
CHAT_MODEL=
CHAT_PROVIDERS=[]
CHAT_MAX_TOKENS=768
CHAT_INPUT_BYTES=12000
CHAT_TIMEOUT_SECONDS=25
CHAT_DEADLINE_SECONDS=30
CHAT_COMPLETION_LIMIT=2
CHAT_MAX_REQUEST_COST_USD=0.10
# USD per million tokens. Preflight rejects unsupported/overpriced endpoints.
CHAT_MAX_PROMPT_PRICE=0.3
CHAT_MAX_COMPLETION_PRICE=2.5
# Optional explicitly configured test recipient for a user-run single SMTP smoke, never automatic.
LOCAL_SMOKE_RECIPIENT=
