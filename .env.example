APP_NAME=shelfcash-backend
ENVIRONMENT=development
POSTGRES_DB=shelfcash
POSTGRES_USER=shelfcash
POSTGRES_PASSWORD=shelfcash
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://shelfcash:shelfcash@127.0.0.1:5432/shelfcash
TEST_DATABASE_URL=postgresql+psycopg://shelfcash:shelfcash@127.0.0.1:5432/shelfcash_test
RUNTIME_DIRECTORY=runtime
UPLOAD_DIRECTORY=runtime/uploads
MODEL_ARTIFACT_DIRECTORY=runtime/model_artifacts
# Optional bounded import-header suggestions; core/manual flow works without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# S4.1 browser origins: exact JSON list. Empty denies browser mutations.
AUTH_ALLOWED_ORIGINS=[]
AUTH_DEV_COOKIE=false
# Configure operator/delivery secrets privately, never commit real values.
AUTH_OPERATOR_ID=
AUTH_OPERATOR_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_DELIVERY_SENDER=
AUTH_FRONTEND_URL=
# S4.2: separate HTTPS invitation page; a private base64-encoded random32-byte key.
# Keep this key available while queued intents exist; never commit a real value.
AUTH_INVITATION_FRONTEND_URL=
AUTH_DELIVERY_ENCRYPTION_KEY=
# S4.4 explicit local worker opt-in. Default startup/health do not connect to DB.
IMPORT_WORKER_ENABLED=false
# S4.9 independent planning execution opt-in; keep false until operator enables.
PLANNING_WORKER_ENABLED=false
# S4.10 independent private retained-PDF worker, explicitly enabled by operator.
PDF_EXPORT_WORKER_ENABLED=false
# Mapping-only model selected by approved classification task. Key stays backend-only.
OPENROUTER_MAPPING_MODEL=qwen/qwen3.5-9b
