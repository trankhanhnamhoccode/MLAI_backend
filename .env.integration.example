# Documentation template only. scripts.integration init generates private values.
# ENVIRONMENT=test selects the existing local cookie transport; this DB is NOT
# shelfcash_test. Automated fixtures/reset tooling reject this separate target.
ENVIRONMENT=test
DATABASE_URL=postgresql+psycopg://shelfcash_integration:REPLACE_LOCALLY@127.0.0.1:5433/shelfcash_integration_s411
RUNTIME_DIRECTORY=runtime/s411/private/app
UPLOAD_DIRECTORY=runtime/s411/private/app/uploads
MODEL_ARTIFACT_DIRECTORY=runtime/s411/private/app/models
AUTH_DEV_COOKIE=true
AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]
AUTH_OPERATOR_ID=s411-local-integration
AUTH_OPERATOR_KEY=GENERATE_PRIVATE_VALUE
AUTH_DELIVERY_ENCRYPTION_KEY=GENERATE_PRIVATE_BASE64_32_BYTES
IMPORT_WORKER_ENABLED=true
IMPORT_LLM_SUGGESTIONS_ENABLED=false
PLANNING_WORKER_ENABLED=true
PDF_EXPORT_WORKER_ENABLED=true
# OPENROUTER_API_KEY and OPENROUTER_MODEL are deliberately absent.
